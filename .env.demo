# Режим публичного демо (Vercel): бэкенда нет, его роль играет MSW в браузере.
# Обычная прод-сборка (.env.production) по-прежнему ходит в реальный API.
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK=true

# Шлюз проксируется через rewrite в vercel.json — напрямую мешает CORS.
# Ключ-эмулятор из документации SMSPILOT: реальные SMS не уходят.
VITE_SMS_GATEWAY_URL=/sms-gateway
VITE_SMS_API_KEY=XXXXXXXXXXXXYYYYYYYYYYYYZZZZZZZZXXXXXXXXXXXXYYYYYYYYYYYYZZZZZZZZ
VITE_SMS_SENDER=
VITE_SMS_TEST_MODE=true
