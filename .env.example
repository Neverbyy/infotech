# Базовый URL API из book.yaml (servers[0].url)
VITE_API_BASE_URL=/api/v1

# true  — запросы перехватывает MSW-мок (src/mocks), бэкенд не нужен
# false — запросы уходят на реальный API по VITE_API_BASE_URL
VITE_USE_MOCK=true

# Куда dev-сервер Vite проксирует /api, когда VITE_USE_MOCK=false.
# Пусто — проксирование выключено (фронт ходит на тот же origin).
VITE_API_PROXY_TARGET=

# ── SMS-уведомления о новинках авторов ───────────────────────────────────
# Читаются ТОЛЬКО моком (src/mocks/sms.ts): в проде SMS рассылает бэкенд,
# и ключ шлюза во фронтенд не попадает.

# Путь до шлюза. /sms-gateway — прокси dev-сервера на https://smspilot.ru/api.php
VITE_SMS_GATEWAY_URL=/sms-gateway

# Ключ SMSPILOT. По умолчанию — ключ-эмулятор из документации:
# запросы принимаются, реальные SMS не отправляются и не тарифицируются.
VITE_SMS_API_KEY=XXXXXXXXXXXXYYYYYYYYYYYYZZZZZZZZXXXXXXXXXXXXYYYYYYYYYYYYZZZZZZZZ

# Зарегистрированное имя отправителя. Пусто — шлюз подставит своё.
VITE_SMS_SENDER=

# false убирает параметр test=1 из запроса к шлюзу
VITE_SMS_TEST_MODE=true
